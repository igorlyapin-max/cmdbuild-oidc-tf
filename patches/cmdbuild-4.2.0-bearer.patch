+/*
+ * CMDBuild has been developed and is managed by PAT srl
+ * You can use, distribute, edit CMDBuild according to the license
+ */
+package org.cmdbuild.auth.config;
+
+/**
+ * Resource-server configuration for validated OIDC access tokens.
+ *
+ * This is deliberately separate from browser OAuth login modules: it never
+ * creates CMDBuild users, exchanges tokens, or accepts a service account.
+ */
+public interface BearerTokenAuthenticationConfiguration {
+
+    boolean isEnabled();
+
+    String getIssuer();
+
+    String getJwksUrl();
+
+    String getAudience();
+
+    String getUserClaim();
+
+    int getClockSkewSeconds();
+
+    String getAllowedJwsAlgorithm();
+
+    String getAuditSinkUrl();
+
+    String getDiagnosticLevel();
+}
