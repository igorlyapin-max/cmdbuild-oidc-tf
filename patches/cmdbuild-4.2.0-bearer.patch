+++ b/cmdbuild/src/main/java/org/cmdbuild/webapp/security/BearerTokenAuthenticationFilter.java	2026-08-10 11:25:48.407668090 +0300
@@ -0,0 +1,204 @@
+/*
+ * CMDBuild has been developed and is managed by PAT srl
+ * You can use, distribute, edit CMDBuild according to the license
+ */
+package org.cmdbuild.webapp.security;
+
+import static com.google.common.hash.Hashing.sha256;
+import jakarta.servlet.FilterChain;
+import jakarta.servlet.ServletException;
+import jakarta.servlet.http.Cookie;
+import jakarta.servlet.http.HttpServletRequest;
+import jakarta.servlet.http.HttpServletRequestWrapper;
+import jakarta.servlet.http.HttpServletResponse;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import static java.util.Collections.emptyEnumeration;
+import static java.util.Collections.list;
+import java.util.Enumeration;
+import java.util.List;
+import org.apache.commons.lang3.StringUtils;
+import org.cmdbuild.auth.config.BearerTokenAuthenticationConfiguration;
+import org.cmdbuild.auth.login.AuthenticationService;
+import org.cmdbuild.auth.login.LoginDataImpl;
+import org.cmdbuild.auth.session.SessionService;
+import static org.cmdbuild.common.http.HttpConst.CMDBUILD_AUTHORIZATION_COOKIE;
+import static org.cmdbuild.common.http.HttpConst.CMDBUILD_AUTHORIZATION_HEADER;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.stereotype.Component;
+import org.springframework.web.filter.OncePerRequestFilter;
+
+/**
+ * Validates an OIDC access token before the legacy session filter can inspect
+ * the Authorization header. A successful token maps only to an existing,
+ * active CMDBuild user and uses a server-side session that is deleted when
+ * the request completes. The session token never leaves the server.
+ */
+@Component
+public class BearerTokenAuthenticationFilter extends OncePerRequestFilter {
+
+    private static final Logger LOGGER = LoggerFactory.getLogger(BearerTokenAuthenticationFilter.class);
+    private static final String AUTHORIZATION_HEADER = "Authorization";
+
+    private final BearerTokenAuthenticationConfiguration configuration;
+    private final BearerTokenJwtValidator validator;
+    private final AuthenticationService authenticationService;
+    private final SessionService sessionService;
+    private final BearerAuthenticationAuditSink auditSink;
+
+    public BearerTokenAuthenticationFilter(BearerTokenAuthenticationConfiguration configuration, BearerTokenJwtValidator validator, AuthenticationService authenticationService, SessionService sessionService, BearerAuthenticationAuditSink auditSink) {
+        this.configuration = configuration;
+        this.validator = validator;
+        this.authenticationService = authenticationService;
+        this.sessionService = sessionService;
+        this.auditSink = auditSink;
+    }
+
+    @Override
+    protected void doFilterInternal(HttpServletRequest request, HttpServletResponse response, FilterChain filterChain) throws ServletException, IOException {
+        BearerHeader bearerHeader = getBearerHeader(request);
+        if (!bearerHeader.isBearer()) {
+            filterChain.doFilter(request, response);
+            return;
+        }
+        if (!configuration.isEnabled()) {
+            filterChain.doFilter(request, response);
+            return;
+        }
+        if (bearerHeader.isMalformed() || hasLegacyCredential(request)) {
+            reject(response, "malformed_or_mixed_credentials", null, request);
+            return;
+        }
+        try {
+            String username = validator.validate(bearerHeader.token(), configuration);
+            if (authenticationService.getUserByUsernameOrNull(username) == null) {
+                throw new BearerTokenValidationException("unknown_or_inactive_user");
+            }
+            String cmdbuildSessionId = sessionService.createAndSet(LoginDataImpl.builder()
+                    .withNoPasswordRequired()
+                    .withLoginString(username)
+                    .allowServiceUser()
+                    .build());
+            try {
+                if (!sessionService.getCurrentSession().getOperationUser().hasDefaultGroup()) {
+                    throw new BearerTokenValidationException("user_has_no_default_group");
+                }
+                String subjectHash = subjectHash(username);
+                audit("accepted", "validated", subjectHash, request);
+                filterChain.doFilter(new AuthorizationStrippingRequestWrapper(request), response);
+            } finally {
+                sessionService.deleteSession(cmdbuildSessionId);
+            }
+        } catch (BearerTokenValidationException ex) {
+            reject(response, ex.getReason(), null, request);
+        } catch (Exception ex) {
+            // Do not log exception messages: they can contain request-derived data.
+            LOGGER.warn("event=bearer.auth.rejected reason=cmdbuild_session_mapping_failed error_type={}", ex.getClass().getSimpleName());
+            reject(response, "cmdbuild_session_mapping_failed", null, request);
+        }
+    }
+
+    private BearerHeader getBearerHeader(HttpServletRequest request) {
+        List<String> values = list(request.getHeaders(AUTHORIZATION_HEADER));
+        boolean containsBearer = values.stream().anyMatch(this::startsWithBearer);
+        if (!containsBearer) {
+            return BearerHeader.noBearer();
+        }
+        if (values.size() != 1) {
+            return BearerHeader.malformed();
+        }
+        String value = values.get(0).trim();
+        if (!startsWithBearer(value)) {
+            return BearerHeader.noBearer();
+        }
+        String token = value.substring("Bearer".length()).trim();
+        return StringUtils.isBlank(token) || token.matches(".*\\s+.*") ? BearerHeader.malformed() : BearerHeader.valid(token);
+    }
+
+    private boolean startsWithBearer(String value) {
+        return value != null && value.regionMatches(true, 0, "Bearer", 0, "Bearer".length())
+                && value.length() > "Bearer".length() && Character.isWhitespace(value.charAt("Bearer".length()));
+    }
+
+    private boolean hasLegacyCredential(HttpServletRequest request) {
+        if (StringUtils.isNotBlank(request.getParameter(CMDBUILD_AUTHORIZATION_HEADER)) || StringUtils.isNotBlank(request.getHeader(CMDBUILD_AUTHORIZATION_HEADER))) {
+            return true;
+        }
+        Cookie[] cookies = request.getCookies();
+        if (cookies == null) {
+            return false;
+        }
+        for (Cookie cookie : cookies) {
+            if (CMDBUILD_AUTHORIZATION_COOKIE.equalsIgnoreCase(cookie.getName())) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    private void reject(HttpServletResponse response, String reason, String subjectHash, HttpServletRequest request) throws IOException {
+        audit("rejected", reason, subjectHash, request);
+        response.setStatus(HttpServletResponse.SC_UNAUTHORIZED);
+        response.setHeader("WWW-Authenticate", "Bearer error=\"invalid_token\"");
+        response.setContentType("application/json");
+        response.setCharacterEncoding("UTF-8");
+        response.getWriter().write("{\"success\":false,\"messages\":[{\"message\":\"invalid bearer token\"}]}");
+    }
+
+    private void audit(String event, String reason, String subjectHash, HttpServletRequest request) {
+        String hash = subjectHash == null ? "none" : subjectHash;
+        LOGGER.info("event=bearer.auth.{} reason={} subject_hash={}", event, reason, hash);
+        auditSink.publish(configuration, event, reason, hash);
+        if ("basic".equalsIgnoreCase(configuration.getDiagnosticLevel()) || "verbose".equalsIgnoreCase(configuration.getDiagnosticLevel())) {
+            LOGGER.info("event=bearer.auth.diagnostic method={} path={}", request.getMethod(), request.getRequestURI());
+        }
+        if ("verbose".equalsIgnoreCase(configuration.getDiagnosticLevel())) {
+            LOGGER.debug("event=bearer.auth.verbose enabled={} algorithm={} audience_configured={}", configuration.isEnabled(), configuration.getAllowedJwsAlgorithm(), StringUtils.isNotBlank(configuration.getAudience()));
+        }
+    }
+
+    private String subjectHash(String username) {
+        return sha256().hashString(username, StandardCharsets.UTF_8).toString().substring(0, 16);
+    }
+
+    private record BearerHeader(boolean isBearer, boolean isMalformed, String token) {
+
+        static BearerHeader noBearer() {
+            return new BearerHeader(false, false, null);
+        }
+
+        static BearerHeader malformed() {
+            return new BearerHeader(true, true, null);
+        }
+
+        static BearerHeader valid(String token) {
+            return new BearerHeader(true, false, token);
+        }
+    }
+
+    private static class AuthorizationStrippingRequestWrapper extends HttpServletRequestWrapper {
+
+        AuthorizationStrippingRequestWrapper(HttpServletRequest request) {
+            super(request);
+        }
+
+        @Override
+        public String getHeader(String name) {
+            return AUTHORIZATION_HEADER.equalsIgnoreCase(name) ? null : super.getHeader(name);
+        }
+
+        @Override
+        public Enumeration<String> getHeaders(String name) {
+            return AUTHORIZATION_HEADER.equalsIgnoreCase(name) ? emptyEnumeration() : super.getHeaders(name);
+        }
+
+        @Override
+        public Enumeration<String> getHeaderNames() {
+            List<String> names = list(super.getHeaderNames()).stream()
+                    .filter(name -> !AUTHORIZATION_HEADER.equalsIgnoreCase(name))
+                    .toList();
+            return java.util.Collections.enumeration(names);
+        }
+    }
+}
diff -ruN a/cmdbuild/src/main/java/org/cmdbuild/webapp/security/BearerTokenJwtValidator.java b/cmdbuild/src/main/java/org/cmdbuild/webapp/security/BearerTokenJwtValidator.java
--- a/cmdbuild/src/main/java/org/cmdbuild/webapp/security/BearerTokenJwtValidator.java	1970-01-01 03:00:00.000000000 +0300
+++ b/cmdbuild/src/main/java/org/cmdbuild/webapp/security/BearerTokenJwtValidator.java	2026-08-10 10:51:45.060019728 +0300
@@ -0,0 +1,124 @@
+/*
+ * CMDBuild has been developed and is managed by PAT srl
+ * You can use, distribute, edit CMDBuild according to the license
+ */
+package org.cmdbuild.webapp.security;
+
+import com.nimbusds.jose.JWSAlgorithm;
+import com.nimbusds.jose.proc.JWSKeySelector;
+import com.nimbusds.jose.proc.JWSVerificationKeySelector;
+import com.nimbusds.jose.proc.SecurityContext;
+import com.nimbusds.jose.util.DefaultResourceRetriever;
+import com.nimbusds.jose.jwk.source.JWKSource;
+import com.nimbusds.jose.jwk.source.RemoteJWKSet;
+import com.nimbusds.jwt.JWTClaimsSet;
+import com.nimbusds.jwt.proc.ConfigurableJWTProcessor;
+import com.nimbusds.jwt.proc.DefaultJWTProcessor;
+import java.net.URL;
+import java.util.Date;
+import java.util.Set;
+import static java.util.concurrent.TimeUnit.SECONDS;
+import org.apache.commons.lang3.StringUtils;
+import org.cmdbuild.auth.config.BearerTokenAuthenticationConfiguration;
+import org.springframework.stereotype.Component;
+
+@Component
+public class BearerTokenJwtValidator {
+
+    private static final int JWKS_CONNECT_TIMEOUT_MILLIS = 2_000;
+    private static final int JWKS_READ_TIMEOUT_MILLIS = 2_000;
+    private static final int JWKS_MAX_RESPONSE_SIZE_BYTES = 1_048_576;
+    private static final Set<String> SUPPORTED_ALGORITHMS = Set.of("RS256", "RS384", "RS512", "ES256", "ES384", "ES512");
+
+    private volatile ProcessorEntry processorEntry;
+
+    public String validate(String token, BearerTokenAuthenticationConfiguration configuration) throws BearerTokenValidationException {
+        try {
+            validateConfiguration(configuration);
+            JWTClaimsSet claims = getProcessor(configuration).process(token, null);
+            validateClaims(claims, configuration);
+            String username = claims.getStringClaim(configuration.getUserClaim());
+            if (StringUtils.isBlank(username)) {
+                throw new BearerTokenValidationException("missing_user_claim");
+            }
+            return username;
+        } catch (BearerTokenValidationException ex) {
+            throw ex;
+        } catch (Exception ex) {
+            throw new BearerTokenValidationException("signature_or_jwks_validation_failed");
+        }
+    }
+
+    private ConfigurableJWTProcessor<SecurityContext> getProcessor(BearerTokenAuthenticationConfiguration configuration) throws Exception {
+        ProcessorKey key = new ProcessorKey(configuration.getJwksUrl(), configuration.getAllowedJwsAlgorithm());
+        ProcessorEntry current = processorEntry;
+        if (current != null && current.key().equals(key)) {
+            return current.processor();
+        }
+        synchronized (this) {
+            current = processorEntry;
+            if (current != null && current.key().equals(key)) {
+                return current.processor();
+            }
+            DefaultResourceRetriever retriever = new DefaultResourceRetriever(JWKS_CONNECT_TIMEOUT_MILLIS, JWKS_READ_TIMEOUT_MILLIS, JWKS_MAX_RESPONSE_SIZE_BYTES);
+            JWKSource<SecurityContext> keySource = new RemoteJWKSet<>(new URL(key.jwksUrl()), retriever);
+            JWSKeySelector<SecurityContext> keySelector = new JWSVerificationKeySelector<>(JWSAlgorithm.parse(key.algorithm()), keySource);
+            ConfigurableJWTProcessor<SecurityContext> processor = new DefaultJWTProcessor<>();
+            processor.setJWSKeySelector(keySelector);
+            processorEntry = new ProcessorEntry(key, processor);
+            return processor;
+        }
+    }
+
+    private void validateConfiguration(BearerTokenAuthenticationConfiguration configuration) throws BearerTokenValidationException {
+        if (StringUtils.isAnyBlank(configuration.getIssuer(), configuration.getJwksUrl(), configuration.getAudience(), configuration.getUserClaim())) {
+            throw new BearerTokenValidationException("incomplete_configuration");
+        }
+        if (!SUPPORTED_ALGORITHMS.contains(configuration.getAllowedJwsAlgorithm())) {
+            throw new BearerTokenValidationException("unsupported_jws_algorithm");
+        }
+        try {
+            URL url = new URL(configuration.getJwksUrl());
+            if (!("http".equals(url.getProtocol()) || "https".equals(url.getProtocol())) || StringUtils.isBlank(url.getHost())) {
+                throw new BearerTokenValidationException("invalid_jwks_url");
+            }
+        } catch (BearerTokenValidationException ex) {
+            throw ex;
+        } catch (Exception ex) {
+            throw new BearerTokenValidationException("invalid_jwks_url");
+        }
+        if (configuration.getClockSkewSeconds() < 0 || configuration.getClockSkewSeconds() > SECONDS.toSeconds(300)) {
+            throw new BearerTokenValidationException("invalid_clock_skew");
+        }
+    }
+
+    private void validateClaims(JWTClaimsSet claims, BearerTokenAuthenticationConfiguration configuration) throws BearerTokenValidationException {
+        if (!StringUtils.equals(configuration.getIssuer(), claims.getIssuer())) {
+            throw new BearerTokenValidationException("issuer_mismatch");
+        }
+        if (claims.getAudience() == null || !claims.getAudience().contains(configuration.getAudience())) {
+            throw new BearerTokenValidationException("audience_mismatch");
+        }
+        if (StringUtils.isBlank(claims.getSubject())) {
+            throw new BearerTokenValidationException("missing_subject");
+        }
+        long now = System.currentTimeMillis(), skewMillis = SECONDS.toMillis(configuration.getClockSkewSeconds());
+        if (claims.getExpirationTime() == null || claims.getExpirationTime().getTime() < now - skewMillis) {
+            throw new BearerTokenValidationException("expired_or_missing_expiration");
+        }
+        Date notBefore = claims.getNotBeforeTime();
+        if (notBefore != null && notBefore.getTime() > now + skewMillis) {
+            throw new BearerTokenValidationException("not_yet_valid");
+        }
+        Date issuedAt = claims.getIssueTime();
+        if (issuedAt == null || issuedAt.getTime() > now + skewMillis) {
+            throw new BearerTokenValidationException("invalid_issued_at");
+        }
+    }
+
+    private record ProcessorKey(String jwksUrl, String algorithm) {
+    }
+
+    private record ProcessorEntry(ProcessorKey key, ConfigurableJWTProcessor<SecurityContext> processor) {
+    }
+}
