diff -ruN a/core/configdefs/src/main/java/org/cmdbuild/config/BearerTokenAuthenticationConfigurationImpl.java b/core/configdefs/src/main/java/org/cmdbuild/config/BearerTokenAuthenticationConfigurationImpl.java
