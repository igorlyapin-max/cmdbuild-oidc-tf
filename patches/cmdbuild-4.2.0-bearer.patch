--- a/cmdbuild/src/main/java/org/cmdbuild/webapp/security/BearerAuthenticationAuditSink.java	1970-01-01 03:00:00.000000000 +0300
+++ b/cmdbuild/src/main/java/org/cmdbuild/webapp/security/BearerAuthenticationAuditSink.java	2026-08-10 10:53:03.891820776 +0300
@@ -0,0 +1,53 @@
+/*
+ * CMDBuild has been developed and is managed by PAT srl
+ * You can use, distribute, edit CMDBuild according to the license
+ */
+package org.cmdbuild.webapp.security;
+
+import java.net.URI;
+import java.net.http.HttpClient;
+import java.net.http.HttpRequest;
+import java.net.http.HttpRequest.BodyPublishers;
+import java.net.http.HttpResponse.BodyHandlers;
+import java.time.Duration;
+import java.time.Instant;
+import static java.util.Objects.requireNonNullElse;
+import org.apache.commons.lang3.StringUtils;
+import org.cmdbuild.auth.config.BearerTokenAuthenticationConfiguration;
+import org.springframework.stereotype.Component;
+
+@Component
+public class BearerAuthenticationAuditSink {
+
+    private final HttpClient client = HttpClient.newBuilder().connectTimeout(Duration.ofSeconds(1)).build();
+
+    public void publish(BearerTokenAuthenticationConfiguration configuration, String event, String reason, String subjectHash) {
+        String sinkUrl = configuration.getAuditSinkUrl();
+        if (StringUtils.isBlank(sinkUrl)) {
+            return;
+        }
+        try {
+            URI uri = URI.create(sinkUrl);
+            if (!isSafeSinkUri(uri)) {
+                return;
+            }
+            String payload = "{\"timestamp\":\"" + Instant.now() + "\",\"level\":\"info\",\"service\":\"cmdbuild\",\"event\":\"bearer.auth." + event + "\",\"reason\":\"" + reason + "\",\"subject_hash\":\"" + requireNonNullElse(subjectHash, "none") + "\"}";
+            HttpRequest request = HttpRequest.newBuilder(uri)
+                    .timeout(Duration.ofSeconds(2))
+                    .header("Content-Type", "application/json")
+                    .POST(BodyPublishers.ofString(payload))
+                    .build();
+            client.sendAsync(request, BodyHandlers.discarding());
+        } catch (Exception ex) {
+            // stdout remains the authoritative audit stream; never recurse by logging a sink error.
+        }
+    }
+
+    private boolean isSafeSinkUri(URI uri) {
+        return ("http".equals(uri.getScheme()) || "https".equals(uri.getScheme()))
+                && StringUtils.isNotBlank(uri.getHost())
+                && uri.getUserInfo() == null
+                && uri.getFragment() == null
+                && uri.getQuery() == null;
+    }
+}
diff -ruN a/cmdbuild/src/main/java/org/cmdbuild/webapp/security/BearerTokenAuthenticationFilter.java b/cmdbuild/src/main/java/org/cmdbuild/webapp/security/BearerTokenAuthenticationFilter.java
