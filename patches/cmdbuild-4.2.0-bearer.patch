@@ -0,0 +1,89 @@
+/*
+ * CMDBuild has been developed and is managed by PAT srl
+ * You can use, distribute, edit CMDBuild according to the license
+ */
+package org.cmdbuild.config;
+
+import org.cmdbuild.auth.config.BearerTokenAuthenticationConfiguration;
+import org.cmdbuild.config.api.ConfigCategory;
+import org.cmdbuild.config.api.ConfigComponent;
+import org.cmdbuild.config.api.ConfigValue;
+import static org.cmdbuild.config.api.ConfigValue.FALSE;
+import org.springframework.stereotype.Component;
+
+@Component
+@ConfigComponent("org.cmdbuild.auth.bearer")
+public class BearerTokenAuthenticationConfigurationImpl implements BearerTokenAuthenticationConfiguration {
+
+    @ConfigValue(key = "enabled", description = "enable validated OIDC bearer access tokens for REST requests", defaultValue = FALSE, category = ConfigCategory.CC_ENV)
+    private Boolean enabled;
+
+    @ConfigValue(key = "issuer", description = "required exact issuer (iss) of access tokens", defaultValue = "", category = ConfigCategory.CC_ENV)
+    private String issuer;
+
+    @ConfigValue(key = "jwksUrl", description = "server-owned HTTP(S) JWKS endpoint used for signature verification", defaultValue = "", category = ConfigCategory.CC_ENV)
+    private String jwksUrl;
+
+    @ConfigValue(key = "audience", description = "required audience (aud) of access tokens", defaultValue = "", category = ConfigCategory.CC_ENV)
+    private String audience;
+
+    @ConfigValue(key = "userClaim", description = "string claim mapped to an existing active CMDBuild username", defaultValue = "preferred_username", category = ConfigCategory.CC_ENV)
+    private String userClaim;
+
+    @ConfigValue(key = "clockSkewSeconds", description = "allowed clock skew for exp, nbf and iat validation (0..300)", defaultValue = "30", category = ConfigCategory.CC_ENV)
+    private Integer clockSkewSeconds;
+
+    @ConfigValue(key = "allowedJwsAlgorithm", description = "one asymmetric JWS algorithm allowed for this deployment (for example RS256)", defaultValue = "RS256", category = ConfigCategory.CC_ENV)
+    private String allowedJwsAlgorithm;
+
+    @ConfigValue(key = "auditSinkUrl", description = "optional server-owned HTTP(S) structured audit sink; leave empty to use stdout only", defaultValue = "", category = ConfigCategory.CC_ENV)
+    private String auditSinkUrl;
+
+    @ConfigValue(key = "diagnosticLevel", description = "off (default), basic or verbose; diagnostics never include credentials or JWT values", defaultValue = "off", category = ConfigCategory.CC_ENV)
+    private String diagnosticLevel;
+
+    @Override
+    public boolean isEnabled() {
+        return enabled;
+    }
+
+    @Override
+    public String getIssuer() {
+        return issuer;
+    }
+
+    @Override
+    public String getJwksUrl() {
+        return jwksUrl;
+    }
+
+    @Override
+    public String getAudience() {
+        return audience;
+    }
+
+    @Override
+    public String getUserClaim() {
+        return userClaim;
+    }
+
+    @Override
+    public int getClockSkewSeconds() {
+        return clockSkewSeconds;
+    }
+
+    @Override
+    public String getAllowedJwsAlgorithm() {
+        return allowedJwsAlgorithm;
+    }
+
+    @Override
+    public String getAuditSinkUrl() {
+        return auditSinkUrl;
+    }
+
+    @Override
+    public String getDiagnosticLevel() {
+        return diagnosticLevel;
+    }
+}
