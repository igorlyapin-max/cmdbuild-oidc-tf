# Public URLs. Keep these aligned with the host address reachable by the browser.
PUBLIC_HOST=192.168.202.35
OPENWEBUI_PUBLIC_PORT=8083
ZITADEL_PUBLIC_PORT=8084
MCP_PUBLIC_PORT=8085
BFF_PUBLIC_PORT=18086

# Isolated CMDBuild POC; does not use the existing CMDBuild volumes or ports.
CMDBUILD_VERSION=4.2.0
POSTGIS_VERSION=17-3.5-alpine
CMDBUILD_HTTP_PORT=18090
CMDBUILD_DB_PORT=15434
CMDBUILD_DB_NAME=cmdbuild_oidc_tf
CMDBUILD_DB_USER=postgres
CMDBUILD_DB_PASSWORD_FILE=./secrets/cmdbuild_db_password
CMDBUILD_APP_PASSWORD_FILE=./secrets/cmdbuild_app_password
CMDBUILD_DUMP=demo.dump.xz
CMDBUILD_JAVA_OPTS=-Xms1024m -Xmx2048m
CMDBUILD_OIDC_CLIENT_ID_FILE=./secrets/cmdbuild_oidc_tf_client_id
CMDBUILD_OIDC_CLIENT_SECRET_FILE=./secrets/cmdbuild_oidc_tf_client_secret
CMDBUILD_OIDC_COMPAT_URL=http://192.168.202.35:8084/cmdbuild-oidc
CMDBUILD_OIDC_REDIRECT_URI=http://127.0.0.1:18090/cmdbuild/oauth2/callback

# Bearer resource-server fork. Leave disabled until the custom image is built,
# an existing active CMDBuild user is mapped, and the validation run is ready.
CMDBUILD_BEARER_ENABLED=false
CMDBUILD_BEARER_ISSUER=http://192.168.202.35:8084
CMDBUILD_BEARER_JWKS_URL=http://192.168.202.35:8084/oauth/v2/keys
# Empty means BFF_OIDC_AUDIENCE; set another exact audience only for a separate resource client.
CMDBUILD_BEARER_AUDIENCE=
CMDBUILD_BEARER_USER_CLAIM=cmdbuild_username
CMDBUILD_BEARER_CLOCK_SKEW_SECONDS=30
CMDBUILD_BEARER_ALLOWED_JWS_ALGORITHM=RS256
CMDBUILD_BEARER_AUDIT_SINK_URL=http://log-collector:18101/v1/logs
CMDBUILD_BEARER_DIAGNOSTIC_LEVEL=off

# Gateway security. The gateway stays fail-closed until all marked values are set.
MCP_GATEWAY_PORT=18100
LOG_COLLECTOR_PORT=18101
OIDC_ISSUER=http://192.168.202.35:8084
OIDC_JWKS_URI=http://192.168.202.35:8084/oauth/v2/keys
OIDC_USERINFO_URL=http://192.168.202.35:8084/oidc/v1/userinfo
OIDC_AUDIENCE=replace-with-zitadel-mcp-client-id
GROUP_CLAIM_NAME=cmdbuild_oidc_tf_groups
GROUP_ADMIN=admin
GROUP_EDITOR=editor
GROUP_READER=reader
CMDBUILD_BASE_URL=http://127.0.0.1:18090
MCP_GATEWAY_URL=http://127.0.0.1:18100/mcp
CMDBUILD_DEMO_CLASS=Building
CMDBUILD_DEMO_CARD_ID=
CMDBUILD_WRITABLE_ATTRIBUTES=Description,Notes

# Direct (no reverse proxy) analogue of cmdbcustompages. Register this client in ZITADEL.
BFF_PORT=18086
BFF_CLIENT_ID=replace-with-zitadel-bff-client-id
BFF_CLIENT_SECRET_FILE=./secrets/bff_client_secret
BFF_REDIRECT_URI=http://192.168.202.35:18086/oauth/callback
BFF_OIDC_AUDIENCE=replace-with-zitadel-bff-client-id

# Basic is normal diagnostic mode. Verbose is temporary and remains redacted.
DIAGNOSTIC_LEVEL=basic
