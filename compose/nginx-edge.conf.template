server {
    listen ${OPENWEBUI_PUBLIC_PORT};
    server_name _;
    client_max_body_size 32m;

    location / {
        proxy_pass http://127.0.0.1:13001;
        proxy_http_version 1.1;
        proxy_set_header Host $host:$server_port;
        proxy_set_header X-Forwarded-Host $host:$server_port;
        proxy_set_header X-Forwarded-Proto http;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}

server {
    listen ${ZITADEL_PUBLIC_PORT};
    server_name _;
    client_max_body_size 16m;

    # CMDBuild 4.2 OP_CUSTOM appends /auth, /token and /userinfo to its
    # configured service URL. ZITADEL uses different endpoint paths. This
    # isolated compatibility route adapts only IdP protocol paths; it does not
    # proxy CMDBuild, the BFF, or cmdbcustompages.
    location = /cmdbuild-oidc/auth {
        proxy_pass http://127.0.0.1:18080/oauth/v2/authorize;
        proxy_http_version 1.1;
        proxy_set_header Host $host:$server_port;
        proxy_set_header X-Forwarded-Host $host:$server_port;
        proxy_set_header X-Forwarded-Proto http;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location = /cmdbuild-oidc/token {
        proxy_pass http://127.0.0.1:18080/oauth/v2/token;
        proxy_http_version 1.1;
        proxy_set_header Host $host:$server_port;
        proxy_set_header X-Forwarded-Host $host:$server_port;
        proxy_set_header X-Forwarded-Proto http;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location = /cmdbuild-oidc/userinfo {
        proxy_pass http://127.0.0.1:18080/oidc/v1/userinfo;
        proxy_http_version 1.1;
        proxy_set_header Host $host:$server_port;
        proxy_set_header X-Forwarded-Host $host:$server_port;
        proxy_set_header X-Forwarded-Proto http;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /ui/v2/login/ {
        proxy_pass http://127.0.0.1:13000;
        proxy_http_version 1.1;
        proxy_set_header Host $host:$server_port;
        proxy_set_header X-Forwarded-Host $host:$server_port;
        proxy_set_header X-Forwarded-Proto http;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location / {
        proxy_pass http://127.0.0.1:18080;
        proxy_http_version 1.1;
        proxy_set_header Host $host:$server_port;
        proxy_set_header X-Forwarded-Host $host:$server_port;
        proxy_set_header X-Forwarded-Proto http;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}

server {
    listen ${MCP_PUBLIC_PORT};
